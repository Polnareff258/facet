# facet 密钥文件模板
#
# 复制为 .env 后填写：  copy .env.example .env     （Linux: cp）
#
# .env 已在 .gitignore 中，**不会被上传**。
# 这里只放密钥；非密钥的个人配置放 config.local.yaml（同样不入库）。
#
# 最简单的配置方式不是手改这个文件，而是跑向导：
#     python -m facet setup
# 它会按需提问、自动写入、并当场验证连通性。

# ── CSQAQ（主力源，强烈建议）─────────────────────────────────
# 一次调用同时返回 BUFF + 悠悠有品 + Steam 的在售价与在售量。
#   1) 到 https://csqaq.com 注册（注册即送 Token）
#   2) 用户头像处复制 ApiToken
#   3) **必须在官网「绑定白名单 IP」绑定本机公网 IP** —— 不绑定会返回 401
CSQAQ_TOKEN=

# ── BUFF（可选，但推荐）──────────────────────────────────────
# 匿名也能用在售价 + 求购价，无需配置。
# 配 Cookie 后额外解锁：按名称搜索饰品（不用再扫 goods_id 空间）、
# 按 paintseed/磨损筛选（档位级在售价）、成交记录。
#
# 获取方式（约 1 分钟）：
#   1) 浏览器登录 https://buff.163.com
#   2) F12 → Network → 刷新页面 → 点任意 api 请求
#   3) Request Headers 里的 Cookie 一行，整行复制（关键字段是 session）
BUFF_COOKIE=

# ── SteamDT（可选）──────────────────────────────────────────
# 在 https://steamdt.com 个人中心 - API管理 申请，限时免费。
# 批量查价 100 个/次但限额 1 次/分钟；额外提供求购价。
STEAMDT_API_KEY=

# ── LLM（可选，用于交易建议）────────────────────────────────
# 推荐做法：用向导，它会按预设自动填对变量名
#     python -m facet setup llm
#
# 或手工：先在 config.local.yaml 写 llm.preset，再在这里填对应的变量。
# 各家预设对应的变量名：
#   preset: deepseek     → DEEPSEEK_API_KEY
#   preset: moonshot     → MOONSHOT_API_KEY
#   preset: dashscope    → DASHSCOPE_API_KEY
#   preset: zhipu        → ZHIPUAI_API_KEY
#   preset: siliconflow  → SILICONFLOW_API_KEY
#   preset: openai       → OPENAI_API_KEY
#   preset: anthropic    → FACET_LLM_API_KEY
#   preset: ollama/lmstudio/vllm（本机）→ 不需要密钥
#
# 也接受通用变量名（任何一种都能被识别）：
FACET_LLM_API_KEY=

# ── 悠悠有品（可选）─────────────────────────────────────────
# 匿名通道已可读求购价，无需配置即可用。
# 如需在售价/租赁行情，需填入已登录态的设备标识（抓包获取）。
# ⚠ 其用户协议限制突破反爬措施取数，请优先使用 CSQAQ / SteamDT
#   这类有授权的数据服务（详见 docs/DATA_SOURCES.md）。
YOUPIN_DEVICE_UK=

# ── 运行参数覆盖（可选）─────────────────────────────────────
# 这些也能写在 config.local.yaml 里，放这里的作用是临时覆盖
# FACET_DB=data/facet.db
# FACET_POLL_INTERVAL=1800
# FACET_CONFIG=config.yaml
